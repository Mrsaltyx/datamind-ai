# Provider LLM : "ollama" (local) ou "remote" (API compatible OpenAI)
LLM_PROVIDER=ollama

# Ollama (LLM local) - utilise quand LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b

# API distante (compatible OpenAI) - utilise quand LLM_PROVIDER=remote
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/
OPENAI_MODEL=glm-5.1

# Base de donnees
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
